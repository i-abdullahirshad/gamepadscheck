---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container">
    
    <!-- Brand Description -->
    <div class="footer-brand">
      <a href="/" class="logo-link">
        <h3>Gamepads<span>Check</span></h3>
      </a>
      <p>The ultimate controller testing utility and technical resource. Diagnose drift, verify polling rates, and optimize your input setup.</p>
    </div>

    <!-- Footer Links -->
    <div class="footer-links">
      
      <!-- New Tools Column with Dots -->
      <div class="link-group">
        <h4>Tools</h4>
        <a href="/" class="tool-link"><span class="dot dot-cyan"></span>Gamepad</a>
        <a href="/fight-stick-tester" class="tool-link"><span class="dot dot-purple"></span>Fight Stick</a>
        <a href="/latency-test" class="tool-link"><span class="dot dot-orange"></span>Latency</a>
        <a href="/steering-wheel-tester" class="tool-link"><span class="dot dot-red"></span>Steering Wheel</a>
        <a href="/xbox-controller-test" class="tool-link"><span class="dot dot-green"></span>Xbox Test</a>
        <a href="/button-mapping-test" class="tool-link"><span class="dot dot-indigo"></span>Button Mapping</a>
      </div>

      <div class="link-group">
        <h4>Resources</h4>
        <a href="/articles">All Articles</a>
      </div>

      <div class="link-group">
        <h4>Legal</h4>
        <a href="/about">About Us</a>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms-of-service">Terms of Service</a>
        <a href="/contact">Contact</a>
      </div>
    </div>
  </div>

  <!-- Copyright -->
  <div class="footer-bottom">
    <p>&copy; {currentYear} GamepadsCheck.com. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    background: var(--bg-panel);
    border-top: 1px solid var(--border-color);
    color: var(--text-muted);
    padding: 4rem 2rem 1.5rem;
  }
  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    margin-bottom: 4rem;
  }
  
  /* Logo Link Styling */
  .logo-link {
    text-decoration: none;
    display: inline-block;
  }
  .footer-brand h3 {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-main);
    margin-top: 0;
    margin-bottom: 1rem;
    transition: opacity 0.2s ease;
  }
  .footer-brand span {
    color: var(--accent-primary);
  }
  .logo-link:hover h3 {
    opacity: 0.8;
  }
  
  .footer-brand p {
    line-height: 1.7;
    font-size: 0.95rem;
    max-width: 300px;
    margin-top: 0;
  }
  
  .footer-links {
    display: flex;
    gap: 4rem;
    justify-content: flex-end;
  }
  .link-group h4 {
    color: var(--text-main);
    margin-bottom: 1.2rem;
    font-size: 1.05rem;
    font-weight: 600;
  }
  .link-group a {
    display: block;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 0.8rem;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }
  
  /* specific styling for tool links to align the dots */
  .link-group a.tool-link {
    display: flex;
    align-items: center;
  }
  .link-group a:hover {
    color: var(--text-main);
  }
  
  /* Ported Dots Styling */
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 0.6rem;
    display: inline-block;
  }
  .dot-cyan { background-color: #00F2FE; box-shadow: 0 0 8px rgba(0, 242, 254, 0.4); }
  .dot-purple { background-color: #A855F7; box-shadow: 0 0 8px rgba(168, 85, 247, 0.4); }
  .dot-orange { background-color: #FF7300; box-shadow: 0 0 8px rgba(255, 115, 0, 0.4); }
  .dot-red { background-color: #F43F5E; box-shadow: 0 0 8px rgba(244, 63, 94, 0.4); }
  .dot-green { background-color: #10B981; box-shadow: 0 0 8px rgba(16, 185, 129, 0.4); }
  .dot-indigo { background-color: #6366F1; box-shadow: 0 0 8px rgba(99, 102, 241, 0.4); }

  .footer-bottom {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
    font-size: 0.85rem;
  }

  /* Responsive styling for smaller screens */
  @media (max-width: 768px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .footer-links {
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 3rem;
    }
  }
</style>