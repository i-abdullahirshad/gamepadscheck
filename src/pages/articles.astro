---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Fetch all 26 articles and sort them by date (newest first)
const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout 
  title="Controller Guides & Technical Resources | GamepadsCheck" 
  description="Explore our complete library of technical guides, troubleshooting steps, and latency breakdowns for modern gamepads and controllers."
>
  <div class="articles-container">
    <header class="page-header">
      <h1>Controller <span>Resources</span></h1>
      <p>Technical breakdowns, fixes, and performance guides for your setup.</p>
    </header>

    <div class="articles-grid">
      {sortedArticles.map((article) => (
        <a href={`/${article.id}`} class="article-card">
          <article>
            <h2>{article.data.title}</h2>
            <p class="description">{article.data.description}</p>
            <div class="card-footer">
              <span class="read-more">Read Guide &rarr;</span>
              <time>{article.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
            </div>
          </article>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .articles-container {
    padding: 2rem 0 4rem;
  }
  
  .page-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .page-header h1 {
    font-size: 3rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .page-header span {
    color: var(--accent-primary);
  }
  .page-header p {
    color: var(--text-muted);
    font-size: 1.15rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }

  .article-card {
    display: block;
    text-decoration: none;
    background: var(--bg-panel);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 2rem;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
  }
  
  .article-card:hover {
    transform: translateY(-5px);
    background: var(--bg-header);
    border-color: var(--accent-primary);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }

  .article-card h2 {
    color: var(--text-main);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.3;
    margin-top: 0;
    margin-bottom: 1rem;
    transition: color 0.2s ease;
  }
  
  .article-card:hover h2 {
    color: var(--accent-primary);
  }

  .description {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    flex-grow: 1; /* Pushes the footer to the bottom */
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 1.25rem;
  }

  .read-more {
    color: var(--accent-primary);
    font-weight: 600;
    font-size: 0.95rem;
  }

  time {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
    .page-header h1 {
      font-size: 2.5rem;
    }
  }
</style>