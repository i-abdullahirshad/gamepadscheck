---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
	title="Steering Wheel Tester: Check Wheel, Pedals & Shifters Online" 
	description="Free steering wheel tester in your browser. Check wheel rotation in degrees, pedal linearity, shifter buttons and raw axis data. No download needed."
>
	

	<div class="header">
		<h1>Steering Wheel Tester</h1>
		<p>Test wheel rotation, verify pedal sensor linearity, and log raw button events.</p>
	</div>

	<div id="api-error" class="error-banner" style="display: none;">
		⚠️ <strong>API Not Supported:</strong> Your browser does not support the Gamepad API.
	</div>

	<!-- UPSCALED 3-COLUMN WIDESCREEN DASHBOARD -->
	<div class="dashboard">
		
		<!-- Column 1: Steering Visualizer -->
		<div class="panel visualizer-panel">
			<div class="visualizer-header">
				<h2 style="margin:0; color: var(--text-main);"><span style="color: #F43F5E;">⭕</span> Visualizer</h2>
				<span id="connection-status" class="status-badge disconnected">Disconnected</span>
			</div>
			
			<div class="visualizer-container">
				<!-- Wheel Rotation SVG (Scaled Up) -->
				<div class="wheel-container">
					<svg class="wheel-svg" viewBox="0 0 200 200">
						<!-- Static crosshairs -->
						<circle cx="100" cy="100" r="90" fill="none" stroke="var(--border-color)" stroke-width="8" />
						<line x1="100" y1="10" x2="100" y2="190" stroke="var(--border-color)" stroke-width="2" />
						<line x1="10" y1="100" x2="190" y2="100" stroke="var(--border-color)" stroke-width="2" />
						<circle cx="100" cy="100" r="30" fill="var(--bg-main)" stroke="var(--border-color)" stroke-width="2"/>
						
						<!-- Rotating Element -->
						<g id="wheel-group" style="transform-origin: center; transition: transform 0.05s linear;">
							<circle cx="100" cy="100" r="90" fill="none" stroke="var(--text-muted)" stroke-width="8" />
							<circle cx="100" cy="10" r="8" fill="#F43F5E" filter="drop-shadow(0 0 8px rgba(244, 63, 94, 0.9))"/>
						</g>
					</svg>
					<div class="rotation-text">
						<span id="wheel-deg" class="deg-val">0°</span>
					</div>
				</div>

				<!-- Pedals (Scaled Up) -->
				<div class="pedals-container">
					<div class="pedal-col">
						<div class="pedal-track">
							<div id="pedal-throttle" class="pedal-fill throttle"></div>
							<span id="throttle-val" class="pedal-pct">0%</span>
						</div>
						<span class="pedal-label throttle-text">THROTTLE</span>
					</div>
					<div class="pedal-col">
						<div class="pedal-track">
							<div id="pedal-brake" class="pedal-fill brake"></div>
							<span id="brake-val" class="pedal-pct">0%</span>
						</div>
						<span class="pedal-label brake-text">BRAKE</span>
					</div>
					<div class="pedal-col">
						<div class="pedal-track">
							<div id="pedal-clutch" class="pedal-fill clutch"></div>
							<span id="clutch-val" class="pedal-pct">0%</span>
						</div>
						<span class="pedal-label clutch-text">CLUTCH</span>
					</div>
				</div>
			</div>
		</div>

		<!-- Column 2: Linearity & Axes -->
		<div class="col-group">
			<!-- Linearity Chart (Taller) -->
			<div class="panel">
				<h3>📈 Pedal Linearity</h3>
				<div class="chart-wrapper">
					<canvas id="linearity-chart" width="400" height="150"></canvas>
					<div class="chart-legend">
						<span class="legend-item"><span class="dot throttle-bg"></span> Throttle</span>
						<span class="legend-item"><span class="dot brake-bg"></span> Brake</span>
						<span class="legend-item"><span class="dot clutch-bg"></span> Clutch</span>
					</div>
				</div>
				<p class="panel-hint">Smooth curves = healthy sensors. Jumpy lines = dirty potentiometers.</p>
			</div>

			<!-- Raw Axis Data (Larger Text/Padding) -->
			<div class="panel">
				<h3>🧭 Raw Axis Data</h3>
				<div class="axis-grid">
					<div class="axis-card">
						<span class="axis-label">Axis 0</span>
						<div id="axis-0-val" class="axis-val">0.000</div>
						<div class="axis-track"><div id="axis-0-bar" class="axis-fill"></div></div>
					</div>
					<div class="axis-card">
						<span class="axis-label">Axis 1</span>
						<div id="axis-1-val" class="axis-val">0.000</div>
						<div class="axis-track"><div id="axis-1-bar" class="axis-fill"></div></div>
					</div>
					<div class="axis-card">
						<span class="axis-label">Axis 2</span>
						<div id="axis-2-val" class="axis-val">0.000</div>
						<div class="axis-track"><div id="axis-2-bar" class="axis-fill"></div></div>
					</div>
					<div class="axis-card">
						<span class="axis-label">Axis 3</span>
						<div id="axis-3-val" class="axis-val">0.000</div>
						<div class="axis-track"><div id="axis-3-bar" class="axis-fill"></div></div>
					</div>
				</div>
			</div>
		</div>

		<!-- Column 3: Buttons & Logs -->
		<div class="col-group">
			<!-- Buttons Grid (Larger Targets) -->
			<div class="panel">
				<h3>🔘 Buttons (<span id="total-buttons-count">17</span>)</h3>
				<div id="all-buttons-grid" class="all-buttons-grid">
					{Array.from({ length: 17 }).map((_, i) => (
						<div class="raw-btn-slot" id={`raw-btn-${i}`}>{i}</div>
					))}
				</div>
			</div>

			<!-- Event Log (Taller) -->
			<div class="panel event-panel">
				<div class="panel-header">
					<h3>📋 Event Log</h3>
					<button id="clear-log-btn" class="icon-btn" title="Clear Log">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
					</button>
				</div>
				<div id="event-log-container" class="event-log">
					<!-- Events injected via JS -->
				</div>
			</div>
		</div>

	</div>

	<div class="info-tip">
		<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F43F5E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
		<span><strong>Tip:</strong> Axis mapping varies by device. If pedals appear swapped or hover at 50%, check your wheel's driver software to combine/split axes.</span>
	</div>

	<article class="content-section">
		<h2>Steering Wheel Tester: Check Wheel, Pedals & Shifters Online</h2>
<p>Your car pulls to one side on a straight. The brake grabs before your foot has really moved. The wheel turns fine in Windows but the game barely reacts.</p>
<p>Any of these could be hardware. Any of these could be settings. Guessing is how people end up buying a new wheel they did not need.</p>
<p>This steering wheel test shows the raw input your PC is receiving. Connect your wheel, turn it, press the pedals, and watch the numbers move in real time. No install, no account, no cost.</p>

<h2>What a Wheel Tester Does</h2>
<p>Racing wheels send several separate signals to your PC at once. The wheel is one axis. Each pedal is its own axis. The shifter, the paddles and every button on the rim are separate inputs again.</p>
<p>This wheel check reads all of them and puts them on one screen. You get:</p>
<ul>
	<li>A rotation dial showing your steering angle in degrees</li>
	<li>Throttle, brake and clutch bars showing travel as a percentage</li>
	<li>A live pedal linearity graph plotting all three pedals as curves</li>
	<li>Raw axis data with values to three decimal places</li>
	<li>A numbered grid of all 17 buttons</li>
	<li>An event log recording every button press in order</li>
</ul>
<p>This matters because a game can only use what it receives. If the brake axis is not moving here, no amount of tweaking inside the game will fix it.</p>

<h2>How to Test Your Steering Wheel Online</h2>
<ol>
	<li>Connect the wheel base to your PC by USB and plug in its power supply.</li>
	<li>Attach the pedals, shifter and handbrake to the base first, then open this page.</li>
	<li>Press any button on the rim so the browser detects the device.</li>
	<li>Turn the wheel fully left, then fully right.</li>
	<li>Press each pedal slowly from rest to the floor and watch the linearity graph.</li>
	<li>Move the shifter through every gear and pull both paddles.</li>
	<li>Press every button on the rim and hub, then read the event log.</li>
</ol>
<p>Power matters here. A wheel connected by USB but not plugged into mains will often show up on your PC while giving no force feedback and sometimes no full rotation.</p>

<h2>Checking Wheel Rotation and Centring</h2>
<p>Start with the wheel itself. Let go and look at the dial.</p>
<ul>
	<li><strong>Healthy wheel:</strong> reads 0 degrees when centred and released</li>
	<li><strong>Off centre:</strong> the wheel physically sits straight but the dial reads 5 or 10 degrees. Your car will drift on straights in every game. This normally means recalibration, not replacement.</li>
</ul>
<p>Even a couple of degrees of offset is enough to feel on a long straight. If you want a finer reading, look at Axis 0 in the raw axis data panel, which shows the same steering position as a decimal between -1.000 and 1.000. A properly centred wheel sits at or very near 0.000 there.</p>
<p>Now turn slowly to full lock each way. The degree reading should climb smoothly with no jumps or flat spots.</p>
<p>Worth noting:</p>
<ul>
	<li><strong>Angle maxes out early:</strong> rotation range is set lower than the hardware allows, usually in the driver software</li>
	<li><strong>Numbers jump or skip:</strong> worn optical encoder or a loose connection</li>
	<li><strong>One side reaches full lock, the other does not:</strong> calibration is off centre</li>
</ul>
<p>Most wheels support 900 degrees of rotation, some go to 1080 and beyond. If the dial hits its limit after only half a turn, check your Logitech G Hub, Thrustmaster Control Panel or Fanatec driver settings before assuming a fault.</p>

<h2>Reading the Pedal Linearity Graph</h2>
<p>This is the most useful part of the tool and the fastest way to test a wheel sensor.</p>
<p>The graph plots throttle in yellow, brake in red and clutch in blue as you press them. Instead of reading numbers and trying to remember what they did a second ago, you see the shape of each pedal's travel drawn out in front of you.</p>
<p>Press one pedal slowly from rest to the floor and back, then read the curve:</p>
<ul>
	<li>A smooth, clean line means the <strong>sensor is healthy</strong></li>
	<li>A jagged or stepped line means a <strong>dirty or worn potentiometer</strong></li>
	<li>A line that flattens before the top means the <strong>pedal is not reaching full travel</strong></li>
	<li>A line that starts above the baseline means the <strong>pedal reads pressed while your foot is off it</strong></li>
	<li>A wobbly line while you hold steady means the <strong>sensor is losing contact</strong></li>
</ul>
<p>The percentage bars next to the graph give you the same information as a single figure. A brake sitting at 20 percent with your foot off it will make the car feel permanently slow, and no in-game tuning will fix that.</p>
<p>Load cell brakes measure pressure rather than travel, so their curve looks different and often steeper. That is normal. What matters is that the line is smooth and returns to zero.</p>

<h2>When Pedals Look Wrong or Sit at 50 Percent</h2>
<p>Axis mapping varies by device, and this trips up a lot of people.</p>
<p>If your pedals appear swapped, or one sits at 50 percent while you are not touching it, the wheel is probably in <strong>combined axis mode</strong>. In that mode the wheel sends throttle and brake down a single axis, with rest sitting at the halfway point. Older Logitech wheels do this by default in some setups.</p>
<p>The fix is in your wheel driver, not in this tool. Look for a combined or split axes option in G Hub, the Thrustmaster Control Panel or your Fanatec driver, and switch to separate axes. Then reload this page and check again.</p>
<p>Cross reference the raw axis data panel while you do this. Press one pedal and see which axis number moves. That tells you exactly how your device is mapped, whatever the labels say.</p>

<h2>Testing Shifters, Paddles and Buttons</h2>
<p>Paddle shifters register as buttons. Pull each one and confirm a separate index lights up in the numbered grid.</p>
<p>An H-pattern shifter sends a different button for every gear. Move through 1 to 6 and reverse, and watch which number lights each time. Every gear should give its own distinct index. Two gears reporting the same number is a wiring or calibration fault, and using the grid as a shifter tester is the quickest way to prove it.</p>
<p>Sequential shifters send one input for up and one for down. Handbrakes can be either an axis or a button depending on model and mode, so pull it and see which panel reacts.</p>
<p>The event log records each press as it happens, with the newest at the top. That is handy for rotary dials, which fire a series of presses as you turn them, and for confirming that a button is not firing twice from one press. Clear the log with the bin icon before a careful run so you are only reading fresh events.</p>

<h2>Which Racing Wheels Work Here</h2>
<p>This wheel test supports:</p>
<ul>
	<li><strong>Logitech:</strong> G29, G920, G923, G Pro Racing Wheel, older G27 and G25</li>
	<li><strong>Thrustmaster:</strong> T150, T248, T300RS, T500RS, TX, TS-XW, T-GT</li>
	<li><strong>Fanatec:</strong> CSL DD, CSL Elite, ClubSport, DD1 and DD2</li>
	<li><strong>Moza:</strong> R3, R5, R9, R12, R16 and R21</li>
	<li>Simagic, Simucube and other direct drive bases</li>
	<li>Budget wheels from PXN, Hori and similar brands</li>
</ul>
<p>Anything Windows recognises as a game controller will report here. Console-only modes may behave differently, so switch the wheel to PC mode if it has a toggle.</p>

<h2>Reading Your Results</h2>
<ul>
	<li><strong>Everything moves correctly:</strong> The hardware is fine. The problem is in the game or the driver. Check that the wheel is selected as the input device and that rotation degrees match between driver and game. A mismatch there is the most common cause of steering that feels wrong.</li>
	<li><strong>Wheel does not centre at 0 degrees:</strong> Recalibrate through the official software. Unplug, let the wheel finish its startup spin without touching it, then check again.</li>
	<li><strong>A pedal reads above zero at rest:</strong> Adjust the deadzone or minimum travel in your driver software. If the reading is high and unstable, the potentiometer is wearing out.</li>
	<li><strong>Pedal curve is jagged:</strong> Dirty or worn sensor. Cleaning helps on some models. On others it is a replacement part.</li>
	<li><strong>Force feedback is missing:</strong> This test cannot show force feedback, because the browser only reads input. Check the power supply, the driver software and your in-game FFB setting.</li>
	<li><strong>Nothing is detected:</strong> Try a rear USB port instead of a hub, confirm the power brick is in, and make sure the wheel finished its startup calibration spin.</li>
</ul>

<h2>When to Run a Steering Wheel Test</h2>
<ul>
	<li>After unboxing a new wheel, before your first race</li>
	<li>When buying secondhand, while the return window is open</li>
	<li>After moving your rig or reconnecting everything</li>
	<li>When a car feels wrong in one game but fine in another</li>
	<li>Before a league race or endurance event</li>
	<li>After a driver or firmware update</li>
	<li>Before selling, so you can describe the condition accurately</li>
</ul>

<h2>Keeping Your Wheel and Pedals Healthy</h2>
<ul>
	<li>Let the wheel complete its startup rotation without touching it</li>
	<li>Keep pedals on a stable surface, since sliding pedals strain the cables</li>
	<li>Do not force the wheel past its rotation limit</li>
	<li>Unplug power when the rig will sit unused for weeks</li>
	<li>Clean dust from around the pedal arms, because grit shortens potentiometer life</li>
	<li>Keep firmware current through your manufacturer's software</li>
</ul>

<h2>Run Your Wheel Check Now</h2>
<p>Plug in your wheel, power it up, and press a button on the rim.</p>
<p>Turn full lock each way and watch the centring. Press each pedal slowly and read the linearity curve. Run through your gears and watch the button grid.</p>
<p>In a couple of minutes you will know whether you are looking at a calibration problem, a driver setting, or hardware that genuinely needs attention.</p>
	</article>

	<style>
		.header { text-align: center; margin-bottom: 2rem; }
		.header h1 { margin-bottom: 0.5rem; font-size: 2rem; color: var(--text-main); }
		.header p { color: var(--text-muted); max-width: 650px; margin: 0 auto; font-family: 'Inter', sans-serif; font-size: 1rem;}

		/* Upscaled 3-Column Layout */
		.dashboard { display: grid; grid-template-columns: 1fr 1.3fr 1fr; gap: 1.5rem; width: 100%; margin-bottom: 2rem; align-items: stretch; }
		.col-group { display: flex; flex-direction: column; gap: 1.5rem; }

		/* Universal Theme Panels */
		.panel { background: var(--bg-panel); border: 1px solid var(--border-color); border-radius: 16px; padding: 1.5rem; backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); box-shadow: 0 16px 40px rgba(0, 0, 0, 0.15); font-family: 'Inter', sans-serif;}
		
		.visualizer-panel { display: flex; flex-direction: column; }
		.event-panel { flex: 1; display: flex; flex-direction: column; }

		.visualizer-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
		.visualizer-header h2 { font-size: 1.4rem; color: var(--text-main); }
		
		.status-badge { padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; border: 1px solid transparent; }
		.status-badge.disconnected { background: var(--border-color); border-color: var(--border-color); color: var(--text-muted); }
		.status-badge.connected { background: rgba(46, 204, 113, 0.1); border-color: #2ECC71; color: #2ECC71; box-shadow: 0 0 10px rgba(46, 204, 113, 0.2); }

		.visualizer-container { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: space-around; gap: 2rem;}

		/* Wheel Visualizer (Upscaled) */
		.wheel-container { position: relative; width: 240px; height: 240px; display: flex; flex-direction: column; align-items: center;}
		.wheel-svg { width: 100%; height: 100%; }
		.rotation-text { text-align: center; margin-top: 1rem; }
		.deg-val { font-size: 2.25rem; font-weight: 800; color: var(--text-main); font-variant-numeric: tabular-nums; }

		/* Vertical Pedals (Upscaled) */
		.pedals-container { display: flex; gap: 2rem; justify-content: center; margin-top: 1rem; }
		.pedal-col { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; }
		
		/* Tinted Inner Elements */
		.pedal-track { width: 55px; height: 180px; background: var(--bg-main); border: 1px solid var(--border-color); border-radius: 10px; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; }
		.pedal-fill { position: absolute; bottom: 0; left: 0; width: 100%; height: 0%; transition: height 0.05s linear; }
		
		/* New Pedal Colors */
		.throttle { background: #FFD700; box-shadow: 0 -4px 15px rgba(255, 215, 0, 0.4); }
		.brake { background: #F43F5E; box-shadow: 0 -4px 15px rgba(244, 63, 94, 0.4); }
		.clutch { background: #3498DB; box-shadow: 0 -4px 15px rgba(52, 152, 219, 0.4); }
		
		.throttle-bg { background: #FFD700; }
		.brake-bg { background: #F43F5E; }
		.clutch-bg { background: #3498DB; }
		
		.throttle-text { color: #FFD700; }
		.brake-text { color: #F43F5E; }
		.clutch-text { color: #3498DB; }

		.pedal-pct { position: relative; z-index: 2; font-weight: 800; color: var(--text-main); text-shadow: 0 1px 2px var(--bg-main); font-size: 1.05rem; }
		.pedal-label { font-size: 0.8rem; font-weight: 800; letter-spacing: 1px; }

		/* Side Modules */
		h3 { color: var(--text-main); font-size: 1.15rem; font-weight: 600; margin: 0 0 1.25rem 0; }
		.panel-hint { font-size: 0.85rem; color: var(--text-muted); margin: 0.75rem 0 0 0; line-height: 1.5;}

		/* Linearity Chart (Upscaled) */
		.chart-wrapper { background: var(--bg-main); border: 1px solid var(--border-color); border-radius: 12px; padding: 1rem; position: relative; }
		#linearity-chart { width: 100%; height: 150px; }
		.chart-legend { display: flex; justify-content: flex-end; gap: 1.25rem; margin-top: 0.75rem; font-size: 0.8rem; color: var(--text-muted); font-weight: 600; }
		.legend-item { display: flex; align-items: center; gap: 6px; }
		.dot { width: 10px; height: 10px; border-radius: 50%; }

		/* Raw Axes (Upscaled) */
		.axis-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
		.axis-card { background: var(--bg-main); border: 1px solid var(--border-color); padding: 1rem; border-radius: 10px; }
		.axis-label { display: block; font-size: 0.85rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.5rem; }
		.axis-val { font-size: 1.25rem; font-weight: 800; color: var(--text-main); font-variant-numeric: tabular-nums; margin-bottom: 0.75rem; }
		.axis-track { width: 100%; height: 6px; background: var(--border-color); border-radius: 3px; position: relative; overflow: hidden; }
		.axis-fill { position: absolute; left: 0; top: 0; height: 100%; width: 50%; background: #F43F5E; transition: width 0.05s linear; }

		/* Buttons Grid (Upscaled) */
		.all-buttons-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; }
		.raw-btn-slot { background: var(--bg-main); border: 1px solid var(--border-color); border-radius: 8px; height: 42px; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: 600; color: var(--text-muted); transition: all 0.05s linear; cursor: default;}
		.raw-btn-slot.active { background: #F43F5E; border-color: #FB7185; color: #FFF; box-shadow: 0 0 12px rgba(244, 63, 94, 0.4); transform: scale(0.95);}

		/* Event Log (Upscaled) */
		.panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
		.icon-btn { background: transparent; border: 1px solid var(--border-color); color: var(--text-muted); border-radius: 8px; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s;}
		.icon-btn:hover { background: var(--border-color); color: var(--text-main); }

		.event-log { flex: 1; background: var(--bg-main); border: 1px solid var(--border-color); border-radius: 12px; padding: 1rem; min-height: 200px; max-height: 300px; overflow-y: auto; font-family: monospace; font-size: 0.9rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 0.4rem; }
		.log-entry span { color: var(--text-main); }
		.log-entry .timestamp { color: var(--text-muted); margin-right: 0.5rem; }
		.log-action-pressed { color: #F43F5E !important; }
		.log-action-released { color: var(--text-muted) !important; }

		.info-tip { display: flex; align-items: center; justify-content: center; gap: 0.75rem; background: rgba(244, 63, 94, 0.05); border: 1px solid rgba(244, 63, 94, 0.2); padding: 1rem 1.5rem; border-radius: 12px; color: var(--text-muted); font-family: 'Inter', sans-serif; font-size: 0.95rem; margin-top: 1rem;}

		@media (max-width: 1200px) {
			.dashboard { grid-template-columns: 1fr 1fr; }
			.visualizer-panel { grid-column: span 2; flex-direction: row; justify-content: space-around; padding: 2.5rem;}
			.visualizer-container { flex-direction: row; width: 100%;}
		}
		@media (max-width: 900px) {
			.dashboard { grid-template-columns: 1fr; }
			.visualizer-panel { grid-column: span 1; flex-direction: column; }
			.visualizer-container { flex-direction: column; }
		}

		/* Content Section Styles */
		.content-section {
			margin-top: 4rem;
			padding: 2.5rem;
