		.player-btn .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--text-muted); transition: all 0.2s; }
		.player-btn.connected { color: var(--text-muted); }
		.player-btn.connected .dot { background: var(--text-muted); }
		.player-btn.active { background: var(--bg-panel); color: var(--text-main); }
