---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
	title="Controller Latency Test: Check Response Time & Input Lag" 
	description="Free controller input lag test in your browser. Measure latency, jitter and polling rate in milliseconds. Unlock 1000Hz precision with WebHID."
>
	
	<div class="dashboard">
		<div class="panel visualizer-panel">
			<div class="visualizer-header">
				<h2 style="margin:0;"><span style="color: #FF7300;">⏱️</span> Latency Visualizer</h2>
				
				<div style="display: flex; gap: 0.75rem; align-items: center;">
					<button id="pause-btn" class="icon-btn" title="Pause/Resume Polling" disabled>
						<svg id="icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
						<svg id="icon-play" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
					</button>
					<span id="connection-status" class="status-badge disconnected">Disconnected</span>
				</div>
			</div>
			
			<div class="visualizer-container">
				<div class="gauge-container">
					<svg class="circular-gauge" viewBox="0 0 200 200">
						<circle class="gauge-bg" cx="100" cy="100" r="80" />
						<circle id="gauge-arc" class="gauge-fill" cx="100" cy="100" r="80" stroke-dasharray="502" stroke-dashoffset="502" />
					</svg>
					<div class="gauge-text">
						<span id="main-latency" class="main-val">--</span>
						<span class="unit">MS</span>
						<span id="main-hz" class="sub-val">-- Hz</span>
					</div>
				</div>

				<div class="chart-container">
					<canvas id="latency-chart" width="400" height="70"></canvas>
				</div>

				<div class="webhid-container" id="webhid-container">
					<button id="webhid-btn" class="webhid-btn">⚡ Unlock 1000Hz (WebHID)</button>
					<p class="webhid-hint">Standard API is limited to ~200Hz. WebHID provides true hardware precision.</p>
				</div>

				<div class="device-info-card">
					<div class="device-header">
						<span class="chip">⚙️ DEVICE CONNECTED</span>
					</div>
					<h3 id="device-name">Waiting for connection...</h3>
					<div class="device-meta">
						<div><span class="meta-label">VENDOR ID</span><br/><span id="vendor-id">----</span></div>
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
						<div><span class="meta-label">PRODUCT ID</span><br/><span id="product-id">----</span></div>
					</div>
				</div>
			</div>
		</div>

		<div class="side-panel-group">
			
			<div class="panel">
				<h3>📊 Latency Statistics</h3>
				<div class="stats-grid">
					<div class="stat-card">
						<span class="stat-label">AVERAGE</span>
						<div class="stat-value"><span id="stat-avg">--</span> <span class="stat-unit">ms</span></div>
					</div>
					<div class="stat-card">
						<span class="stat-label">JITTER</span>
						<div class="stat-value" style="color: var(--text-main);"><span id="stat-jitter">--</span> <span class="stat-unit">ms</span></div>
					</div>
					<div class="stat-card">
						<span class="stat-label">MINIMUM</span>
						<div class="stat-value"><span id="stat-min">--</span> <span class="stat-unit">ms</span></div>
					</div>
					<div class="stat-card">
						<span class="stat-label">MAXIMUM</span>
						<div class="stat-value"><span id="stat-max">--</span> <span class="stat-unit">ms</span></div>
					</div>
				</div>
			</div>

			<div class="panel">
				<h3>⚡ Polling Rate</h3>
				<div class="polling-card">
					<span id="stat-hz" class="polling-val">--</span>
					<span class="polling-unit">HZ</span>
				</div>
			</div>

			<div class="panel">
				<h3>ℹ️ Latency Guide</h3>
				<div class="guide-list">
					<div class="guide-item" style="border-color: rgba(46, 204, 113, 0.3);">
						<div class="guide-dot" style="background: #2ECC71; box-shadow: 0 0 8px #2ECC71;"></div>
						<div class="guide-text"><strong>0-2ms</strong><br/><span>Excellent • Pro-level (1000Hz)</span></div>
					</div>
					<div class="guide-item" style="border-color: rgba(52, 152, 219, 0.3);">
						<div class="guide-dot" style="background: #3498DB; box-shadow: 0 0 8px #3498DB;"></div>
						<div class="guide-text"><strong>2-5ms</strong><br/><span>Great • Wired USB (250Hz+)</span></div>
					</div>
					<div class="guide-item" style="border-color: rgba(243, 195, 0, 0.3);">
						<div class="guide-dot" style="background: #F3C300; box-shadow: 0 0 8px #F3C300;"></div>
						<div class="guide-text"><strong>5-8ms</strong><br/><span>Average • 2.4GHz Wireless</span></div>
					</div>
					<div class="guide-item" style="border-color: rgba(231, 76, 60, 0.3);">
						<div class="guide-dot" style="background: #E74C3C; box-shadow: 0 0 8px #E74C3C;"></div>
						<div class="guide-text"><strong>8ms+</strong><br/><span>High • Standard Bluetooth</span></div>
					</div>
				</div>
			</div>

		</div>
	</div>

	<div class="info-tip">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF7300" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
		<span><strong>Note:</strong> Continuously rotate your analog sticks to force the hardware to send data packets for accurate polling.</span>
	</div>

	<article class="content-section">
		<h1>Controller Latency Test: Check Response Time & Input Lag</h1>
<img src="/images/latency-tester.png" alt="Controller Latency Test dashboard displaying average input lag in milliseconds, connection jitter, polling rate in Hz, and a live latency visualizer" class="article-image" style="width: 100%; max-width: 100%; height: auto; display: block; margin: 2rem 0; border-radius: 12px; border: 1px solid var(--border-color); box-shadow: 0 4px 20px rgba(0,0,0,0.2);" />
<p>You press the button. The character reacts a fraction too late. It is small enough that you cannot prove it, but big enough that you keep losing trades you should be winning.</p>
<p>That gap has a number. This input lag test measures it.</p>
<p>Connect your controller, press a few buttons, and the tool reports how many milliseconds pass between updates from your device. No install, no cost, works in any modern browser.</p>

<h2>What Controller Latency Actually Is</h2>
<p>Input lag is the delay between your finger moving and the game reacting. It builds up in stages:</p>
<ul>
	<li><strong>Button travel:</strong> the physical time the switch takes to close</li>
	<li><strong>Controller processing:</strong> the pad turning that press into data</li>
	<li><strong>Transmission:</strong> sending it over cable, Bluetooth or a wireless dongle</li>
	<li><strong>Polling:</strong> how often your PC receives a fresh update</li>
	<li><strong>Game engine:</strong> the game reading the input and acting on it</li>
	<li><strong>Display:</strong> your monitor drawing the result</li>
</ul>
<p>This controller latency test measures the transmission and polling part of that chain. It cannot see your game engine or your screen, but it tells you whether your controller and its connection are adding delay before the game is even involved.</p>
<p>That is the part you can actually change.</p>

<h2>How to Run the Input Delay Test</h2>
<ol>
	<li>Connect your controller by cable, Bluetooth or a wireless dongle.</li>
	<li>Open this page and press any button so the browser detects it.</li>
	<li>Keep giving the pad something to report. Hold a stick and move it in slow circles, or tap buttons steadily.</li>
	<li>Let it run for twenty to thirty seconds so the statistics settle.</li>
	<li>Read the average, not any single number.</li>
</ol>
<p>The tool measures the gap between updates arriving from your controller. Constant movement keeps those updates flowing, which is why rolling a stick gives a cleaner reading than pressing one button now and then.</p>
<p>Close heavy programs before you start. A running game, a video render or a big file copy will all inflate your result.</p>

<h2>Unlock True 1000Hz With WebHID</h2>
<p>This is the part that separates a real latency tester from a rough estimate.</p>
<p>The standard browser Gamepad API is capped at roughly 200Hz. Even if your controller sends data faster than that, the browser will not show it, so your reading hits a floor of about 5ms no matter how good your hardware is.</p>
<p>The Unlock 1000Hz button switches the tool to WebHID, which reads the device directly and gives true hardware precision. If you own a high polling rate pad, this is the only way to see what it is really doing.</p>
<ul>
	<li>Click Unlock 1000Hz and approve the device in the browser prompt</li>
	<li>Chrome and Edge support WebHID. Firefox and Safari do not</li>
	<li>Your vendor ID and product ID appear once connected, confirming the exact device</li>
</ul>
<p>If you skip this step, treat any result under 5ms as "at the limit of what the browser can see" rather than a true figure.</p>

<h2>Reading Your Latency Numbers</h2>
<p>The guide on the page sorts results into four bands:</p>
<ul>
	<li><strong>0ms to 2ms:</strong> excellent, pro level, typical of a 1000Hz connection</li>
	<li><strong>2ms to 5ms:</strong> great, normal for wired USB at 250Hz or above</li>
	<li><strong>5ms to 8ms:</strong> average, typical of a 2.4GHz wireless dongle</li>
	<li><strong>8ms and above:</strong> high, typical of standard Bluetooth</li>
</ul>
<p>Notice how tight those bands are. This is not a reaction time test, so human numbers like 200ms do not apply here. You are measuring how quickly the hardware talks to your PC, and good hardware does that in single digit milliseconds.</p>
<p>The statistics panel gives you four figures:</p>
<ul>
	<li><strong>Average:</strong> your main result, the number to compare between setups</li>
	<li><strong>Jitter:</strong> how much the timing varies from one update to the next</li>
	<li><strong>Minimum:</strong> the best gap recorded</li>
	<li><strong>Maximum:</strong> the worst gap recorded</li>
</ul>
<p>Jitter deserves as much attention as the average, so it helps to understand <a href="/controller-jitter">controller jitter and why it matters</a>. A controller that averages 3ms but spikes to 20ms is worse to play on than one that sits steadily at 6ms. Consistency is what your hands learn. Random spikes are what break your timing. If your minimum and maximum are far apart, you have an unstable connection rather than a slow one.</p>

<h2>Wired vs Wireless Controller Latency</h2>
<p>This is the question most people are really asking.</p>
<p>Wired USB is the fastest and the most consistent. There is nothing to interfere with it. If you want the lowest possible input delay, use a cable. Expect to land in the 2ms to 5ms band, or lower with WebHID and a high polling rate pad.</p>
<p>2.4GHz dongles come close to wired. A dedicated receiver means less negotiation and fewer collisions than Bluetooth. The Xbox Wireless Adapter and most third party dongles sit in the 5ms to 8ms band. See our breakdown of <a href="/controller-dongle-vs-bluetooth-latency">dongle vs Bluetooth latency compared</a> to see how much stability you gain.</p>
<p>Bluetooth is the slowest and the most variable. It shares crowded spectrum with WiFi, phones and everything else on 2.4GHz. It is fine for casual play and noticeably worse for competitive play, pushing many players to research <a href="/wired-vs-wireless-controller">wired vs wireless for competitive play</a>. Bluetooth pads usually report 8ms or more, often with higher jitter as well.</p>
<p>Test your own setup both ways instead of trusting general numbers. Your room, your dongle and your USB ports all affect the result.</p>

<h2>Polling Rate and Why It Matters</h2>
<p>Polling rate is how many times per second your controller sends its current state. The tool shows this live in Hz next to your latency reading, so you can see the two move together.</p>
<ul>
	<li><strong>125Hz</strong> means an update every 8ms</li>
	<li><strong>250Hz</strong> means every 4ms</li>
	<li><strong>500Hz</strong> means every 2ms</li>
	<li><strong>1000Hz</strong> means every 1ms</li>
</ul>
<p>Most standard controllers report at 125Hz or 250Hz. Higher end and third party pads support 1000Hz. Running a polling rate test on your own controller is the quickest way to find out which group yours falls into, and to learn <a href="/good-controller-polling-rate">what counts as a good polling rate</a>. This is also crucial information when testing <a href="/fight-stick-tester">precision fight stick polling rates</a>.</p>
<p>A higher polling rate lowers the worst case delay between your press and your PC noticing it. The gain from 125Hz to 500Hz is real but small. The gain from 500Hz to 1000Hz is very small. If you are reading marketing material and wondering <a href="/8000hz-controller-polling">is 8000Hz polling worth it</a>, do not spend money chasing it unless everything else in your chain is already sorted.</p>

<h2>What Causes High Controller Latency</h2>
<p>If your numbers came back worse than expected, work through these.</p>

<h3>Connection problems</h3>
<ul>
	<li>Bluetooth interference from routers, phones or other paired devices (which can also cause <a href="/bluetooth-audio-delay-controller">Bluetooth audio delay</a>)</li>
	<li>A wireless dongle plugged into a crowded USB hub</li>
	<li>Distance or obstacles between controller and receiver</li>
	<li>A low battery, which makes some pads cut transmission power</li>
</ul>

<h3>PC side problems</h3>
<ul>
	<li>Background downloads, updates or virus scans</li>
	<li>Too many browser tabs eating CPU time</li>
	<li>Power saving modes throttling your USB ports</li>
	<li>Overlay software from Steam, Discord or your GPU driver (if you are wondering <a href="/does-steam-input-add-input-lag">does Steam Input add input lag</a>, check your global settings)</li>
</ul>

<h3>Hardware problems</h3>
<ul>
	<li>A cheap or damaged USB cable</li>
	<li>Outdated controller firmware</li>
	<li>Some third party pads simply have slower internal processing</li>
</ul>

<h2>How to Reduce Controller Input Lag</h2>
<p>Cheapest fixes first.</p>
<ul>
	<li>Switch to a wired connection. This is the single biggest improvement available.</li>
	<li>Move a wireless dongle to a front port or a short extension, closer to you and away from metal.</li>
	<li>Use a rear motherboard USB port for wired pads rather than a hub.</li>
	<li>Charge the controller fully before testing or playing.</li>
	<li>Close background apps using CPU or network.</li>
	<li>Update controller firmware through the manufacturer's app.</li>
	<li>Turn off unnecessary overlays in Steam and Discord.</li>
	<li>Disable USB power saving in Windows Device Manager under USB Root Hub properties.</li>
</ul>
<p>Run the delay test again after each change so you know which one actually helped. Change one thing at a time or you will not learn anything.</p>

<h2>When to Run a Latency Test</h2>
<ul>
	<li>Before a ranked session or a tournament</li>
	<li>After switching between wired and wireless</li>
	<li>When comparing two controllers before deciding which to keep</li>
	<li>After a Windows or driver update</li>
	<li>When a game suddenly feels heavier than it did last week</li>
	<li>Before buying a new pad, to confirm the old one is actually the problem</li>
	<li>After moving your setup to a different room</li>
</ul>

<h2>Understanding the Limits of This Test</h2>
<p>Be honest about what these numbers cover.</p>
<p>This measures the delay between your controller and your browser. It does not include your monitor response time, your game engine delay, your frame rate, or your network ping in online play. If you want a monitor delay test or a full system latency figure, you need different tools that can see the display side of the chain.</p>
<p>Total lag in a real match is always higher than what you see here. What this gives you is the input portion in isolation, which is exactly what you need when working out whether the problem is your pad or something further down the line.</p>
<p>If your input latency reads low but the game still feels slow, look at your display, your frame rate or your connection rather than your controller.</p>

<h2>Start Your Controller Latency Test</h2>
<p>Plug in your controller and press any button to begin. Click Unlock 1000Hz if you are on Chrome or Edge and want true precision.</p>
<p>Let it run for half a minute, note your average and your jitter, then change one thing and test again. Within a few minutes you will know whether your controller is adding delay or whether the lag you feel is coming from somewhere else entirely.</p>
	</article>

	<style>
		.dashboard { display: grid; grid-template-columns: 2fr 1fr; gap: 1rem; width: 100%; margin-bottom: 1rem; }

		.panel { background: var(--bg-panel); border: 1px solid var(--border-color); border-radius: 14px; padding: 1.25rem; backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); box-shadow: 0 16px 40px rgba(0, 0, 0, 0.15); font-family: 'Inter', sans-serif;}
		
		.visualizer-panel { display: flex; flex-direction: column; justify-content: space-between; }
		.side-panel-group { display: flex; flex-direction: column; gap: 1rem; }

		.visualizer-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
		.visualizer-header h2 { margin: 0; font-size: 1.15rem; color: var(--text-main); display: flex; align-items: center; gap: 0.5rem;}
		
		.status-badge { padding: 5px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; border: 1px solid transparent; }
		.status-badge.disconnected { background: var(--border-color); border-color: var(--border-color); color: var(--text-muted); }
		.status-badge.connected { background: rgba(46, 204, 113, 0.1); border-color: #2ECC71; color: #2ECC71; box-shadow: 0 0 10px rgba(46, 204, 113, 0.2); }
		.status-badge.webhid { background: rgba(255, 115, 0, 0.1); border-color: #FF7300; color: #FF7300; box-shadow: 0 0 10px rgba(255, 115, 0, 0.3); }

		.icon-btn { background: transparent; border: 1px solid var(--border-color); color: var(--text-muted); border-radius: 20px; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s;}
		.icon-btn:not(:disabled):hover { background: var(--border-color); color: var(--text-main); border-color: var(--text-muted); }
		.icon-btn:disabled { opacity: 0.3; cursor: not-allowed; }
		.icon-btn.paused { border-color: #FF7300; color: #FF7300; background: rgba(255, 115, 0, 0.1); box-shadow: 0 0 10px rgba(255, 115, 0, 0.2); }

		.visualizer-container { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; }

		/* Circular Gauge */
		.gauge-container { position: relative; width: 160px; height: 160px; display: flex; align-items: center; justify-content: center; }
		.circular-gauge { width: 100%; height: 100%; transform: rotate(-90deg); position: absolute; top: 0; left: 0; }
		.gauge-bg { fill: none; stroke: var(--border-color); stroke-width: 10; }
		.gauge-fill { fill: none; stroke: #FF7300; stroke-width: 10; stroke-linecap: round; transition: stroke-dashoffset 0.1s linear; filter: drop-shadow(0 0 8px rgba(255, 115, 0, 0.5)); }
		
		.gauge-text { text-align: center; z-index: 2; display: flex; flex-direction: column; align-items: center; justify-content: center; margin-top: 2px; }
		.main-val { font-size: 2rem; font-weight: 800; color: #FF7300; line-height: 1.1; font-variant-numeric: tabular-nums; }
		.unit { font-size: 0.85rem; color: var(--text-muted); font-weight: 600; letter-spacing: 1px; margin-bottom: 0.25rem; }
		.sub-val { font-size: 0.8rem; color: var(--text-muted); background: var(--bg-main); padding: 2px 8px; border-radius: 8px; font-variant-numeric: tabular-nums;}

		/* Histogram */
		.chart-container { width: 100%; max-width: 400px; height: 70px; position: relative; }
		#latency-chart { width: 100%; height: 100%; }

		/* WebHID Button */
		.webhid-container { width: 100%; max-width: 400px; text-align: center; }
		.webhid-btn { width: 100%; background: var(--text-main); color: var(--bg-main); border: none; padding: 0.75rem; border-radius: 10px; font-weight: 700; font-size: 0.95rem; cursor: pointer; transition: all 0.2s; font-family: 'Inter', sans-serif; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
		.webhid-btn:hover { background: var(--text-muted); box-shadow: 0 4px 15px rgba(0,0,0,0.2); transform: translateY(-1px); }
		.webhid-btn.active { background: rgba(46, 204, 113, 0.15); color: #2ECC71; border: 1px solid #2ECC71; box-shadow: none; pointer-events: none; }
		.webhid-hint { font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem; margin-bottom: 0; }

		/* Device Card */
		.device-info-card { background: var(--bg-main); border: 1px solid var(--border-color); border-radius: 10px; padding: 1rem; width: 100%; max-width: 400px; text-align: center; }
		.device-header { margin-bottom: 0.5rem; }
		.chip { background: rgba(52, 152, 219, 0.15); color: #3498DB; border: 1px solid rgba(52, 152, 219, 0.3); font-size: 0.65rem; font-weight: 700; padding: 3px 6px; border-radius: 4px; letter-spacing: 1px; }
		.device-info-card h3 { margin: 0 0 0.75rem 0; font-size: 0.95rem; color: var(--text-main); word-wrap: break-word; }
		
		.device-meta { display: flex; justify-content: space-around; align-items: center; border-top: 1px solid var(--border-color); padding-top: 0.75rem; }
		.meta-label { font-size: 0.6rem; color: var(--text-muted); font-weight: 700; letter-spacing: 1px; }
		.device-meta span:not(.meta-label) { font-family: monospace; color: var(--text-muted); font-size: 0.85rem; }

		/* Side Modules */
		h3 { color: var(--text-main); font-size: 1rem; font-weight: 600; margin: 0 0 1rem 0; }
		
		.stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
		.stat-card { background: var(--bg-main); border: 1px solid var(--border-color); padding: 0.75rem; border-radius: 8px; }
		.stat-label { display: block; font-size: 0.65rem; font-weight: 700; color: var(--text-muted); letter-spacing: 1px; margin-bottom: 0.25rem; }
		.stat-value { font-size: 1.3rem; font-weight: 800; color: #FF7300; font-variant-numeric: tabular-nums; display: flex; align-items: baseline; gap: 4px;}
		.stat-unit { font-size: 0.75rem; color: var(--text-muted); font-weight: 600; }

		.polling-card { background: var(--bg-main); border: 1px solid var(--border-color); padding: 1rem; border-radius: 8px; text-align: center; }
		.polling-val { font-size: 2rem; font-weight: 800; color: #A855F7; text-shadow: 0 0 15px rgba(168, 85, 247, 0.4); font-variant-numeric: tabular-nums;}
		.polling-unit { font-size: 0.9rem; color: var(--text-muted); font-weight: 700; }

		.guide-list { display: flex; flex-direction: column; gap: 0.5rem; }
		.guide-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem; background: var(--bg-main); border: 1px solid transparent; border-radius: 6px; }
		.guide-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
		.guide-text strong { color: var(--text-main); font-size: 0.85rem; }
		.guide-text span { color: var(--text-muted); font-size: 0.75rem; }

		.info-tip { display: flex; align-items: center; justify-content: center; gap: 0.75rem; background: rgba(255, 115, 0, 0.05); border: 1px solid rgba(255, 115, 0, 0.2); padding: 0.75rem; border-radius: 10px; color: var(--text-muted); font-family: 'Inter', sans-serif; font-size: 0.85rem; }

		@media (max-width: 900px) {
			.dashboard { grid-template-columns: 1fr; }
		}

		/* Content Section Styles */
		.content-section {
			margin-top: 1rem;
			padding: 2rem;
			background: var(--bg-panel);
			border: 1px solid var(--border-color);
			border-radius: 16px;
			color: var(--text-muted);
			font-family: 'Inter', sans-serif;
			line-height: 1.7;
