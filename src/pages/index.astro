---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
	title="Gamepad Tester: Check Your Controller & Joystick Online" 
	description="Free online gamepad tester. Check buttons, stick drift, triggers, vibration and mic in your browser. No download, works with Xbox, PS5 and PS4 pads."
>

	<div id="api-error" class="error-banner" style="display: none;">
		⚠️ <strong>API Not Supported:</strong> Your current browser does not support the Web Gamepad API. Please use a modern version of Chrome, Edge, or Firefox.
	</div>

	<div class="dashboard">
