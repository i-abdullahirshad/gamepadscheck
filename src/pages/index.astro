				<div class="module-col">
					<div class="trigger-track"><div id="lt-bar" class="trigger-fill"></div></div>
					<div class="data-row">LT: <span id="lt-data">0.00</span></div>
				</div>
				<div class="module-col">
					<div class="trigger-track"><div id="rt-bar" class="trigger-fill"></div></div>
					<div class="data-row">RT: <span id="rt-data">0.00</span></div>
				</div>
			</div>
		</div>

		<div class="panel">
			<h2>📳 Vibration Test</h2>
